# =====================================================================
# JARVIS — ENVIRONMENT VARIABLES  (.env.example)
# =====================================================================
# 1. Copy this file to `.env` in the same folder, then fill in the blanks.
# 2. `.env` itself must NEVER be committed to git — it's already in
#    .gitignore per Phase 0 of the Build Workflow.
# 3. Sections marked "PICK ONE" are alternatives — you need exactly
#    one of that group, not all of them. Delete the ones you skip.
# 4. Everything else is grouped by the phase that first needs it, so
#    you can fill this in gradually as you actually get there —
#    you do NOT need all of this on day one.
# =====================================================================


# ---------------------------------------------------------------------
# PHASE 1 — The brain (required before anything else runs)
# ---------------------------------------------------------------------

# --- LLM brain — PICK ONE of the four, delete the other three ---

# Anthropic Claude — PAID ($2/$10 per million tokens, Sonnet 5).
# Best tool-calling reliability; the recommended pick once you're
# past Phase 1 and into voice/desktop automation.
# Get it: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# OpenAI GPT-5.4 — PAID (roughly comparable to Claude; OpenAI has
# repriced this a few times in 2026, check platform.openai.com/pricing
# for today's number).
# Get it: platform.openai.com -> API keys
OPENAI_API_KEY=

# Google Gemini — FREE tier (Flash / Flash-Lite only, rate-limited to
# ~1,000-1,500 requests/day, no card). Good for proving Phase 1 works
# at zero cost.
# Get it: aistudio.google.com -> Get API key
GOOGLE_API_KEY=

# Groq — FREE tier (30 req/min, 14,400 req/day, no card). Only runs
# open-source models (Llama, Qwen, GPT-OSS) — very fast, decent but
# not top-tier tool-calling reliability.
# Get it: console.groq.com
GROQ_API_KEY=

# --- Weather — your first real tool ---

# OpenWeatherMap — FREE (60 calls/min, up to 1,000,000/month, no card).
# Get it: openweathermap.org/api
OPENWEATHERMAP_API_KEY=


# ---------------------------------------------------------------------
# PHASE 2 — Voice in, voice out
# ---------------------------------------------------------------------

# Deepgram (speech-to-text) — FREEMIUM ($200 free credit, no card).
# Urdu + English code-switching, sub-300ms latency.
# Get it: console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech) — FREEMIUM (10,000 free characters/month).
# Get it: elevenlabs.io
ELEVENLABS_API_KEY=


# ---------------------------------------------------------------------
# PHASE 3 — Voice lock (wake word "jarvis" + PIN)
# ---------------------------------------------------------------------

# No account needed for this phase at all — openWakeWord's "hey_jarvis"
# model is bundled with the library, and webrtcvad needs no key either.
# The one thing to set yourself:

# A PIN of your choosing — typed into the popup window after the wake
# word is heard. Not issued by anyone; you pick it.
JARVIS_PIN=


# ---------------------------------------------------------------------
# PHASE 4 — Desktop automation
# ---------------------------------------------------------------------
# No new keys. Uses your Phase 1 brain key (Claude's native `computer`
# tool) or runs fully local (OmniParser + a local vision model).


# ---------------------------------------------------------------------
# PHASE 5 — WhatsApp (whatsapp-web.js bridge, not Evolution API)
# ---------------------------------------------------------------------
# No Docker, no Postgres, no Redis — the bridge (whatsapp_bridge/server.js)
# is a single Node.js process. Nothing here is a signup either.

# Where your own running bridge lives — matches BRIDGE_PORT in
# whatsapp_bridge/server.js (default 3001).
WHATSAPP_BRIDGE_URL=http://localhost:3001

# A random secret YOU generate (e.g. `openssl rand -hex 32`). Set the
# SAME value as the WEBHOOK_SECRET environment variable when you run
# the bridge — it's how your FastAPI webhook verifies a call really
# came from your bridge, not from anyone who finds the URL.
WEBHOOK_SECRET=

# Your own WhatsApp number, international format, no leading '+'
# (e.g. 923001234567). How Jarvis tells Command Mode (you) apart from
# Dictation Mode (everyone else).
JARVIS_OWNER_NUMBER=

# Optional — only if you use a persistent named Cloudflare Tunnel
# instead of a free ephemeral `cloudflared tunnel --url ...` (which
# needs no account at all).
CLOUDFLARE_TUNNEL_TOKEN=


# ---------------------------------------------------------------------
# PHASE 6 — Remaining modules (fill in as you build each one)
# ---------------------------------------------------------------------

# --- Email ---
# Gmail API — FREE, but OAuth, not a single pasted key: the first two
# come from a project you create in Google Cloud Console; the refresh
# token is generated the first time you complete the auth flow.
# Get it: console.cloud.google.com -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Scheduling ---
# APScheduler runs locally — no key needed.

# --- Memory / notes (only once you build semantic search) ---
# Voyage AI (embeddings) — FREEMIUM (200 million free tokens, no card
# — realistically free forever at personal-notes volume).
# Skip entirely if you use the free local option instead (Granite
# Embedding Multilingual R2) — that needs no key at all.
# Get it: voyageai.com
VOYAGE_API_KEY=

# --- Social media posting ---
# Meta Graph API — FREE API access, but requires a developer app and
# an Instagram Business account linked to a Facebook Page.
# Get it: developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Research ---
# SerpAPI — FREEMIUM (~100-250 free searches/month). Optional — skip
# if your brain is Claude, whose native web_search tool covers this
# without a separate key.
SERPAPI_API_KEY=

# --- Browser automation ---
# Playwright runs locally — no key needed, unless you use Claude's
# native `browser` tool (already covered by your Phase 1 brain key).

# --- Coding tool ---
# Also covered by your brain key (Claude's `text_editor` tool) —
# nothing new to add here.

# --- Maps ---
# Google Maps Platform — FREEMIUM (per-API free tiers, e.g. ~10,000
# free geocoding requests/month). Optional — skip for the fully free
# OpenStreetMap/Nominatim route, which needs no key at all.
GOOGLE_MAPS_API_KEY=


# ---------------------------------------------------------------------
# PHASE 7 — Middleware & safety
# ---------------------------------------------------------------------
# No new external keys — HumanInTheLoop, Summarization, PII and retry
# middleware are all code/config against services you've already set
# up above, not new services.


# ---------------------------------------------------------------------
# PHASE 8 — Reliability & observability (optional, add when you get here)
# ---------------------------------------------------------------------

# LangSmith — FREEMIUM (free tier covers personal-project volume).
# Lets you see exactly what the agent reasoned after something
# unexpected happens.
# Get it: smith.langchain.com
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=jarvis


# ---------------------------------------------------------------------
# GENERAL APP CONFIG (not secrets, but they live here too)
# ---------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
DAILY_COST_CAP_USD=5
